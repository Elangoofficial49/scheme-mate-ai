# Project Environment Variables
PROJECT_NAME="SchemeMate AI"
ENVIRONMENT=development
DEBUG=True

# Security Credentials (DO NOT COMMIT REAL PRODUCTION KEYS TO GIT)
JWT_SECRET=schememate_ai_super_secret_jwt_key_2026_change_in_production
JWT_REFRESH_SECRET=schememate_ai_super_secret_refresh_key_2026_change_in_production

# Database Connection (Default SQLite for local offline testing)
DATABASE_URL=sqlite:///./schememate.db

# For Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-SUPABASE-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Supabase Transaction Pooler (Session mode / Port 5432 or 6543):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Redis Connection
REDIS_URL=redis://localhost:6379/0

# AI Provider Settings ("local", "openai", "gemini")
AI_PROVIDER=local
AI_API_KEY=your_openai_or_gemini_api_key_here
EMBEDDING_MODEL=all-MiniLM-L6-v2

# OCR Engine ("local_regex", "tesseract", "paddleocr")
OCR_PROVIDER=local_regex

